# LIFELINK NAGPUR Environment Configuration
PORT=5000
NODE_ENV=development

# Relational Database (PostgreSQL)
# Users, Hospitals, Capacity, Specialists, Ambulances, Incidents, Confirmations, Blood Banks
POSTGRES_URL=postgresql://lifelink_user:lifelink_pass@localhost:5432/lifelink_nagpur

# Document / Event Stream Database (MongoDB)
# Real-time event timeline, Location history, Notifications, Audit logs
MONGODB_URL=mongodb://localhost:27017/lifelink_nagpur

# Optional AI Triage Key (Google Gemini or LLM API)
# If not provided, LIFELINK uses the built-in intelligent clinical NLP triage engine
AI_API_KEY=

# Map Configuration (OpenStreetMap / Leaflet tiles are free and default)
VITE_API_URL=http://localhost:5000
